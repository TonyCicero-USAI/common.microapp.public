{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "landing": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "loader": {
              ".ttf": "file"
            },
            "outputPath": {
              "base": "dist/landing",
              "browser": ""
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/data",
              {
                "glob": "**/*",
                "input": "app/assets",
                "output": "assets/"
              }
            ],
            "styles": [
              "./node_modules/bootstrap-css-only/css/bootstrap-grid.min.css",
              "app/styles.less",
              "src/default.less",
              "./node_modules/material-symbols/index.css",
              "./node_modules/@fontsource/roboto/300.css",
              "./node_modules/@fontsource/roboto/400.css",
              "./node_modules/@fontsource/roboto/500.css",
              "./node_modules/@fontsource/roboto/700.css",
              "./node_modules/@fontsource/source-sans-pro/300.css",
              "./node_modules/@fontsource/source-sans-pro/400.css",
              "./node_modules/@fontsource/source-sans-pro/600.css",
              "./node_modules/@fontsource/source-sans-pro/700.css",
              "./node_modules/@fontsource/open-sans/300.css",
              "./node_modules/@fontsource/open-sans/400.css",
              "./node_modules/@fontsource/open-sans/500.css",
              "./node_modules/@fontsource/open-sans/600.css",
              "./node_modules/@fontsource/open-sans/700.css",
              "./node_modules/@fontsource/dancing-script/index.css",
              {
                "input": "src/default.less",
                "bundleName": "default",
                "inject": false
              },
              {
                "input": "./node_modules/bootstrap-css-only/css/bootstrap-grid.min.css",
                "bundleName": "bootstrap-grid",
                "inject": false
              },
              {
                "input": "src/light.less",
                "bundleName": "light",
                "inject": false
              },
              {
                "input": "src/dark.less",
                "bundleName": "dark",
                "inject": false
              },
              {
                "input": "src/black.less",
                "bundleName": "black",
                "inject": false
              },
              {
                "input": "./node_modules/material-symbols/index.css",
                "bundleName": "material-symbols",
                "inject": false
              },
              {
                "input": "app/styles.less",
                "bundleName": "app",
                "inject": false
              }
            ],
            "scripts": [
              "./node_modules/reflect-metadata/Reflect.js"
            ],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "allowedCommonJsDependencies": [
              "highcharts",
              "lodash",
              "class-transformer",
              "core-js",
              "dom-to-image",
              "ipaddr.js",
              "rgbcolor",
              "raf",
              "crypto-js"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "optimized": {
              "baseHref": "/",
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "12mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "production": {
              "baseHref": "/",
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "12mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4210,
            "buildTarget": "landing:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "landing:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "landing:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "styles": [
              "./node_modules/bootstrap-css-only/css/bootstrap-grid.min.css",
              "src/default.less",
              {
                "input": "src/light.less",
                "bundleName": "light",
                "inject": true
              },
              {
                "input": "src/dark.less",
                "bundleName": "dark",
                "inject": true
              },
              {
                "input": "src/black.less",
                "bundleName": "black",
                "inject": true
              }
            ],
            "scripts": [
            ],
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/data"
            ],
            "codeCoverageExclude": [
              "src/**/*.module.ts",
              "src/app/shared/objects/*.ts",
              "src/app/shared/auth-session.ts",
              "src/app/main/GlobalErrorHandler.ts"
            ]
          }
        }
      }
    },
    "landing-e2e": {
      "root": "e2e/",
      "projectType": "application",
      "prefix": "",
      "architect": {
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "landing:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "landing:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}